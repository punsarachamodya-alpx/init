{
  "name": "colombo-release-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node --experimental-strip-types src/db/migrate-cli.ts",
    "eval:intake": "node --experimental-transform-types scripts/eval-intake.ts",
    "set-actor-key": "node --experimental-transform-types scripts/set-actor-key.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed:demo": "node --experimental-transform-types scripts/seed-demo.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
